# Copy to .env and adjust. .env is git-ignored; this file is not.
# Nothing in here is a real credential — these are local development values.

# --- database ---------------------------------------------------------------
POSTGRES_DB=drishya
POSTGRES_USER=drishya
POSTGRES_PASSWORD=drishya_local_only
# 5433 because a locally installed PostgreSQL already owns 5432.
POSTGRES_PORT=5433

# What the backend connects with. Matches the docker-compose service above.
# In AWS these come from Beanstalk environment properties or Secrets Manager,
# never from a file in the repository.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/drishya
SPRING_DATASOURCE_USERNAME=drishya
SPRING_DATASOURCE_PASSWORD=drishya_local_only

# --- frontend ---------------------------------------------------------------
# Left empty in development so the Vite proxy handles /api and the browser
# stays on one origin. Set to the deployed API origin for a hosted build.
VITE_API_BASE=

# --- prediction -------------------------------------------------------------
# How often active trips are re-estimated, in ms. Every cycle wakes the database,
# so on a serverless tier this decides whether compute is spent overnight on
# nothing. Raise it when idle.
ETA_CYCLE_MS=60000

# Guards /api/v1/internal/training-data, which is cross-tenant and cannot be
# exposed to a normal bearer token. Unset means the endpoint 404s.
INTERNAL_SERVICE_TOKEN=

# --- deployment (Render / Vercel / Neon) ------------------------------------
# Set on Render, not here. Neon's DIRECT connection string, not the pooled one —
# its pooler is PgBouncer in transaction mode and breaks Hibernate's prepared
# statements. Must end with ?sslmode=require.
#   SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.aws.neon.tech/drishya?sslmode=require
#
# The Vercel origin(s), comma separated. The first thing that breaks on a real
# deploy: locally the Vite proxy hides CORS, deployed it does not.
CORS_ALLOWED_ORIGINS=
