# --- frontend ---------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- backend ----------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
*.class

# --- IDE --------------------------------------------------------------------
# IntelliJ's workspace file records window layout and open tabs — noise in a
# diff. The rest of .idea can be useful to share, but not on a solo project.
.idea/
*.iml
.vscode/
*.swp

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- logs and runtime -------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
logs/
*.pid
*.h2.db

# --- secrets ----------------------------------------------------------------
# .env holds the local database password. .env.example is committed; .env never is.
.env
.env.local

# --- trained models ---------------------------------------------------------
# Build outputs, not source. The backend serves the heuristic when they are
# absent, which is the correct default for a fresh clone.
Drishya.Backend/models/*.onnx
Drishya.Backend/models/features.json
ml/data/

# --- verification scratch -----------------------------------------------------
# The UI checks write screenshots next to themselves when a run is being
# debugged. Useful locally, noise in a diff.
/*.png
/*.mjs
!Drishya.Backend/scripts/*.mjs
