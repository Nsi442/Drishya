# --- frontend ---------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- backend ----------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
*.class

# --- IDE --------------------------------------------------------------------
# IntelliJ's workspace file records window layout and open tabs — noise in a
# diff. The rest of .idea can be useful to share, but not on a solo project.
.idea/
*.iml
.vscode/
*.swp

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- logs and runtime -------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
logs/
*.pid
*.h2.db

# --- secrets ----------------------------------------------------------------
# .env holds the local database password. .env.example is committed; .env never is.
.env
.env.local

# --- trained models ---------------------------------------------------------
# Build outputs, not source. The backend serves the heuristic when they are
# absent, which is the correct default for a fresh clone.
Drishya.Backend/models/*.onnx
Drishya.Backend/models/features.json
ml/data/

# --- verification scratch -----------------------------------------------------
# The UI checks write screenshots next to themselves when a run is being
# debugged. Useful locally, noise in a diff.
/*.png
/*.mjs
!Drishya.Backend/scripts/*.mjs

# Written by aws/deploy.sh: the database master password and the JWT signing
# key for the deployed stack. Kept because a re-run must reuse them — changing
# the database password on a live instance leaves the container authenticating
# with the old one — but it is exactly the file that must never be committed.
/.aws-secrets.env

# Python bytecode. The repository has no Python package — the scripts/ files are
# run directly — so a __pycache__ only ever appears because something imported
# one as a module, which is what a test harness does. Build cruft, not work.
__pycache__/
*.py[cod]
