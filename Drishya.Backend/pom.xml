<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>com.drishya</groupId>
	<artifactId>drishya-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Drishya Backend</name>
	<description>REST API for Drishya — vendor-to-fulfilment-centre shipment visibility</description>

	<properties>
		<java.version>21</java.version>
		<!--
		  Boot 4.1.0 manages Hibernate 7.4.1.Final, and hibernate-spatial is one
		  of the artifacts its BOM covers. Never pin a version on it by hand:
		  hibernate-spatial and hibernate-core must move together or the dialect
		  fails to register the PostGIS types.
		-->
	</properties>

	<dependencies>
		<!-- REST endpoints + embedded Tomcat. The Initializr scaffold had only
		     the base starter, so the app had no web layer at all. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Liveness and readiness probes. Beanstalk's health check points at
		     /actuator/health/readiness in Phase 6. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Bean validation on request bodies. The frontend validates too, but
		     the API cannot trust it. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
		  PostGIS support. hibernate-spatial registers the geography/geometry
		  types with the Postgres dialect and pulls org.locationtech.jts:jts-core
		  in transitively — JTS is NOT managed by the Boot BOM, so letting it
		  arrive this way is what keeps it aligned with Hibernate.

		  JTS types stay inside the entity layer. Nothing hands a Point to
		  Jackson; DTOs expose plain lat/lon doubles. See DTO note in README.
		-->
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-spatial</artifactId>
		</dependency>

		<!--
		  Swagger UI at /swagger-ui.html, and the OpenAPI document behind it.

		  springdoc 3.x is the line that tracks Spring Boot 4 — its major version
		  moves in lockstep with Boot's, so the 2.x releases every tutorial still
		  shows are Boot 3 only and fail here at auto-configuration time. Not in the
		  Boot BOM, so the version is pinned by hand.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!--
		  ONNX Runtime, for serving a trained ETA model.

		  Pinned by hand because this is NOT managed by the Spring Boot BOM. It has
		  no Spring coupling at all, so there is no Boot 4 compatibility question
		  here, only a version to choose.

		  It stays out of the way when unused: OnnxEtaModel only activates when
		  models/eta.onnx actually exists, so a deployment that has never trained a
		  model pays for the class loading and nothing else.
		-->
		<dependency>
			<groupId>com.microsoft.onnxruntime</groupId>
			<artifactId>onnxruntime</artifactId>
			<version>1.19.2</version>
		</dependency>

		<!--
		  Schema is migration-managed from here on; ddl-auto is off.

		  This must be the STARTER, not plain org.flywaydb:flyway-core. Boot 4
		  split auto-configuration out of the monolithic jar into focused
		  modules, and Flyway's lives in spring-boot-flyway which only this
		  starter pulls in. With flyway-core alone the application starts
		  perfectly happily, runs no migrations at all, and then fails on the
		  first query with "relation does not exist" — there is no warning that
		  Flyway was never wired up.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!-- Flyway 10+ split each database into its own module; without this
		     one Flyway reports "Unsupported Database: PostgreSQL". -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!--
		  Spring Security 7, and the resource server that validates our JWTs.

		  spring-security-crypto used to be here on its own, for BCrypt and
		  nothing else — the filter chain was hand-rolled. The resource server
		  starter brings the Nimbus JOSE library that issues and verifies real
		  JWTs, so the bespoke userId.expiry.hmac token could be retired.

		  Spring Security 7 has NO implicit behaviour: with the starter on the
		  classpath and no SecurityFilterChain declared, every endpoint is
		  secured behind a generated password and the whole API returns 401.
		  SecurityConfig declares every rule explicitly, which is the only way it
		  works and also the only way it is reviewable.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!--
		  Promoted from <optional> to a plain runtime dependency: Postgres is no
		  longer the alternative profile, it is the only database. H2 was
		  dropped because it has no spatial support at all, and every geofence
		  and lane query in this system runs in PostGIS.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Cuts the entity/DTO boilerplate. IntelliJ bundles Lombok support;
		     Maven picks up the annotation processor from the dependency alone. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  Real PostGIS in the tests. H2 cannot answer ST_DWithin, so a spatial
		  query that "compiles" proves nothing — Hibernate 7 can also emit
		  different SQL than 6 for the same HQL. These run it for real.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Testcontainers 2.0 renamed every module: the old org.testcontainers:postgresql
		  and :junit-jupiter coordinates no longer exist. Boot 4.1.0 imports
		  testcontainers-bom 2.0.5, which publishes them as testcontainers-postgresql
		  and testcontainers-junit-jupiter. Copying a Boot 3 snippet here fails the
		  build with "version is missing" rather than anything mentioning the rename.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  JDK 23 turned OFF implicit annotation processing: a processor sitting
			  on the classpath is no longer discovered automatically, so Lombok
			  silently generated nothing and every getter/setter came back as
			  "cannot find symbol". Declaring the processor path explicitly and
			  asking for -proc:full is the supported fix.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<proc>full</proc>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
